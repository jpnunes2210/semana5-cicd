# Copie para frontend/.env.local (nao versionado).

# Semana 5: base da API Django. Vazio = caminho relativo /api/ (atras do Nginx).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Semana 6: fonte de dados da tela. "api" (Django) ou "firestore".
NEXT_PUBLIC_DATA_SOURCE=api

# true = conecta no Firestore do Emulator Suite em vez do Firestore de producao
NEXT_PUBLIC_USE_EMULATOR=false
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIRESTORE_EMULATOR_PORT=8080
