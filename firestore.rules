rules_version = '2';

// Mesmo principio do nivel 3 da Missao Farol: leitura publica, escrita negada.
// Os itens so sao criados pelo console do Firebase (que ignora as regras).
service cloud.firestore {
  match /databases/{database}/documents {
    match /items/{item} {
      allow read: if true;
      allow write: if false;
    }
  }
}
